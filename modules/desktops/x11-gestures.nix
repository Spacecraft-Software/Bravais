# Steelbore Bravais — touchpad gestures for the X11 sessions (Touchégg)
#
# KWin's touchpad gestures exist only in its Wayland compositor: on Plasma
# X11 neither its built-in swipes nor the steelbore-gestures KWin script
# (users/mj/plasma.nix) ever fire. LeftWM has none of its own. Touchégg reads
# the touchpad through libinput in a system daemon and hands each gesture to
# a client in the session, which performs the action there. The scheme is the
# one in docs/keybindings.md: fingers follow the content, so a left swipe goes
# to the workspace on the right, and a swipe up opens the overview.
#
# `services.touchegg` is deliberately NOT used: it adds the package to the
# system profile, and the package ships an XDG autostart entry for the
# client, so every session that honours autostart -- Plasma Wayland, GNOME,
# COSMIC -- would start a client on top of its compositor's own gestures.
# Here the package is referenced by store path only and the client is started
# by the two X11 sessions alone: a user unit for Plasma X11, LeftWM's theme
# hook (modules/desktops/leftwm.nix) for LeftWM.
{
  config,
  lib,
  pkgs,
  steelborePalette,
  ...
}:
let
  cfg = config.steelbore.desktops.x11Gestures;
  package = pkgs.touchegg;
  hex = lib.removePrefix "#";

  # A Touchégg client configuration as a directory, for XDG_CONFIG_HOME: the
  # client reads $XDG_CONFIG_HOME/touchegg/touchegg.conf, so each session can
  # run its own without touching ~/.config. `next` / `previous` are SEND_KEYS
  # specs or CHANGE_DESKTOP; `overview` / `grid` are commands.
  mkConfig =
    name:
    {
      next,
      previous,
      overview,
      grid ? null,
    }:
    let
      keys = combo: animation: ''
        <action type="SEND_KEYS">
          <repeat>false</repeat>
          <modifiers>${combo.modifiers}</modifiers>
          <keys>${combo.keys}</keys>
          <on>begin</on>
          <animation>${animation}</animation>
        </action>'';
      run = command: ''
        <action type="RUN_COMMAND">
          <repeat>false</repeat>
          <command>${command}</command>
          <on>begin</on>
        </action>'';
      swipe = fingers: direction: action: ''
        <gesture type="SWIPE" fingers="${toString fingers}" direction="${direction}">
          ${action}
        </gesture>'';
      forFingers = fingers: ''
        ${swipe fingers "LEFT" (keys next "CHANGE_DESKTOP_RIGHT")}
        ${swipe fingers "RIGHT" (keys previous "CHANGE_DESKTOP_LEFT")}
      '';
    in
    pkgs.writeTextDir "touchegg/touchegg.conf" ''
      <touchégg>
        <settings>
          <property name="animation_delay">150</property>
          <property name="action_execute_threshold">20</property>
          <property name="color">${hex steelborePalette.accent}</property>
          <property name="borderColor">${hex steelborePalette.accent}</property>
        </settings>
        <!-- ${name}. Generated by modules/desktops/x11-gestures.nix. -->
        <application name="All">
          ${forFingers 3}
          ${forFingers 4}
          ${swipe 3 "UP" (run overview)}
          ${swipe 4 "UP" (run overview)}
          ${lib.optionalString (grid != null) (swipe 4 "DOWN" (run grid))}
        </application>
      </touchégg>
    '';

  # The workspace keys every session shares (docs/keybindings.md), which the
  # mouse side buttons send too: Super+Ctrl+Right is the next workspace.
  nextWorkspace = {
    modifiers = "Super_L+Control_L";
    keys = "Right";
  };
  previousWorkspace = {
    modifiers = "Super_L+Control_L";
    keys = "Left";
  };

  # KWin's own global actions, the ones Meta+W and Meta+G trigger, by name:
  # no key has to stay bound for the gesture to work.
  kwinShortcut =
    name:
    "${pkgs.dbus}/bin/dbus-send --session --type=method_call --dest=org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut string:'${name}'";

  plasmaConfig = mkConfig "Plasma X11" {
    next = nextWorkspace;
    previous = previousWorkspace;
    overview = kwinShortcut "Overview";
    grid = kwinShortcut "Grid View";
  };

  # The client keeps its instance lock beside its configuration
  # ($XDG_CONFIG_HOME/touchegg/.touchegg<display>.lock, opened O_CREAT) and
  # exits at once when it cannot create it, so XDG_CONFIG_HOME cannot be the
  # read-only store directory itself. Stage a private, writable directory
  # that links the generated file, then exec, so the PID stays touchegg's
  # (LeftWM's pidfile check reads /proc/<pid>/comm).
  client =
    configDir:
    "${pkgs.writeShellScript "steelbore-touchegg-client" ''
      dir="''${XDG_RUNTIME_DIR:-$HOME/.cache}/steelbore-touchegg"
      ${pkgs.coreutils}/bin/mkdir -p -m 700 "$dir/touchegg"
      ${pkgs.coreutils}/bin/ln -sfn ${configDir}/touchegg/touchegg.conf "$dir/touchegg/touchegg.conf"
      export XDG_CONFIG_HOME="$dir"
      exec ${lib.getExe' package "touchegg"}
    ''}";
in
{
  options.steelbore.desktops.x11Gestures = {
    enable = lib.mkEnableOption "touchpad gestures in the X11 sessions (Plasma X11, LeftWM) via Touchégg";

    mkClient = lib.mkOption {
      type = lib.types.functionTo lib.types.str;
      readOnly = true;
      default =
        overview:
        client (
          mkConfig "LeftWM" {
            next = nextWorkspace;
            previous = previousWorkspace;
            inherit overview;
          }
        );
      description = ''
        Given the overview command, the shell command that starts a Touchégg
        client with the shared workspace swipes. LeftWM's theme hook runs it,
        as it has no systemd graphical session.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = config.steelbore.desktops.plasma.enable || config.steelbore.desktops.leftwm.enable;
        message = "steelbore.desktops.x11Gestures serves Plasma X11 and LeftWM; enable one of them.";
      }
    ];

    # The daemon: libinput on every touchpad, gestures to clients over the
    # abstract socket `touchegg`, which lives in the network namespace (so no
    # PrivateNetwork). Upstream runs it as root; it needs only what the input
    # group grants (/dev/input/event* are root:input 0660) and udev's
    # world-readable /run/udev, so it runs as a throwaway user in that group.
    # Any local process can reach the socket and feed this C++ parser, which
    # is the reason not to leave it root.
    systemd.services.touchegg = {
      description = "Touchégg touchpad gesture daemon (X11 sessions)";
      wantedBy = [ "multi-user.target" ];
      serviceConfig = {
        ExecStart = "${lib.getExe' package "touchegg"} --daemon";
        DynamicUser = true;
        SupplementaryGroups = [ "input" ];
        DeviceAllow = [ "char-input rw" ];
        DevicePolicy = "closed";
        Restart = "on-failure";
        RestartSec = 5;
        NoNewPrivileges = true;
        ProtectSystem = "strict";
        ProtectHome = true;
        PrivateTmp = true;
        ProtectKernelTunables = true;
        ProtectKernelModules = true;
        ProtectControlGroups = true;
        ProtectClock = true;
        RestrictSUIDSGID = true;
        LockPersonality = true;
        RestrictRealtime = true;
        RestrictNamespaces = true;
        RestrictAddressFamilies = [
          "AF_UNIX"
          "AF_NETLINK"
        ];
        SystemCallArchitectures = "native";
        CapabilityBoundingSet = "";
      };
    };

    # Plasma X11's client. plasma-workspace-x11.target exists only in the X11
    # session, so Plasma Wayland -- where KWin has gestures of its own -- never
    # starts it.
    systemd.user.services.steelbore-gestures-plasma = lib.mkIf config.steelbore.desktops.plasma.enable {
      description = "Touchégg client for Plasma X11 (touchpad gestures)";
      partOf = [ "plasma-workspace-x11.target" ];
      after = [ "plasma-workspace-x11.target" ];
      wantedBy = [ "plasma-workspace-x11.target" ];
      serviceConfig = {
        ExecStart = client plasmaConfig;
        Restart = "on-failure";
        RestartSec = 2;
      };
    };
  };
}
