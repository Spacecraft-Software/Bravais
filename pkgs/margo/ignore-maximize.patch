 impl MargoState {
+    /// Window rule `ignore_maximize:1` drops this toplevel's maximize and
+    /// unmaximize requests (margo maps maximize to fullscreen). Matched on
+    /// the identity the client holds now, not on `MargoClient`: Chromium
+    /// restores its saved maximized state before the deferred initial map
+    /// applies any rule. The last matching rule that sets it wins.
+    fn toplevel_ignores_maximize(&self, toplevel: &ToplevelSurface) -> bool {
+        let (app_id, title) = super::super::read_toplevel_identity(toplevel);
+        self.matching_window_rules(&app_id, &title)
+            .iter()
+            .filter_map(|(_, rule)| rule.ignore_maximize)
+            .last()
+            .unwrap_or(false)
+    }
